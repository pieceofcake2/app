<?xml version="1.0" encoding="UTF-8"?>
<!--
    vendor/bin/phpunit runs the App suite (defaultTestSuite). Select the End-to-End tests
    (pieceofcake2/panther) with the testsuite option: "EndToEnd", or "App,EndToEnd" for everything.
    Remove defaultTestSuite="App" to make vendor/bin/phpunit run everything, as in Symfony.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="./tests/bootstrap.php"
         backupGlobals="true"
         defaultTestSuite="App"
         stderr="true"
         colors="true">
    <php>
        <ini name="memory_limit" value="-1"/>
        <!-- Deprecations are shown on stderr, once, and do not fail the tests -->
        <ini name="display_errors" value="stderr"/>
        <ini name="log_errors" value="0"/>
        <!--
            tests/bootstrap.php sets APP_ENV=test (when not set), so config/core.php loads config/.env.test, where
            DATABASE_URL is the test database. The web server of the End-to-End tests inherits
            APP_ENV, so it loads config/.env.test too and reads the fixtures.
        -->
        <!--
            End-to-End tests (pieceofcake2/panther) are configured with PANTHER_* variables, as in
            Symfony Panther. A <server> element replaces a shell variable of the same name: put
            per-machine values such as PANTHER_NO_HEADLESS in your shell or in phpunit.xml.
        -->
        <!-- Screenshots of the failed End-to-End tests -->
        <server name="PANTHER_ERROR_SCREENSHOT_DIR" value="./tmp/error-screenshots"/>
    </php>
    <!--
        Keeps the web server and the browser running for the whole run of End-to-End tests.
        Enable it when you install pieceofcake2/panther.
    -->
    <!--
    <extensions>
        <extension class="PieceOfCake2\Panther\ServerExtension"/>
    </extensions>
    -->
    <listeners>
        <listener class="CakeFixtureInjector" file="./vendor/pieceofcake2/cakephp/src/TestSuite/Fixture/CakeFixtureInjector.php"/>
    </listeners>
    <testsuites>
        <testsuite name="App">
            <directory>./tests/TestCase/</directory>
            <exclude>./tests/TestCase/EndToEnd/</exclude>
        </testsuite>
        <testsuite name="EndToEnd">
            <directory>./tests/TestCase/EndToEnd/</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </coverage>
</phpunit>

{
    "name": "pieceofcake2/app",
    "description": "CakePHP 2 application skeleton with a CakePHP 5-style directory layout",
    "type": "project",
    "keywords": ["cakephp", "skeleton"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "pieceofcake2/cakephp": "^2.13",
        "symfony/dotenv": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/bake": "^1.0",
        "pieceofcake2/debug_kit": "^2.2",
        "pieceofcake2/docs": "^2.0",
        "pieceofcake2/phpcs-cakephp2": "^1.2",
        "pieceofcake2/phpstan-cakephp2": "^1.1"
    },
    "suggest": {
        "pieceofcake2/panther": "Browser End-to-End tests with Symfony Panther in tests/TestCase/EndToEnd/ (the EndToEnd suite of phpunit.xml.dist)",
        "dbrekelmans/bdi": "Downloads a chromedriver that matches the installed Chrome for pieceofcake2/panther (vendor/bin/bdi detect drivers)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-paths": {
            "plugins/{$name}/": ["type:cakephp-plugin"]
        }
    }
}

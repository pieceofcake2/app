{
    "name": "pieceofcake2/app",
    "description": "CakePHP 2 application skeleton with a CakePHP 5-style directory layout",
    "type": "project",
    "keywords": ["cakephp", "skeleton"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "josegonzalez/dotenv": "^4.0",
        "pieceofcake2/cakephp": "^2.12.6"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/bake": "^1.0",
        "pieceofcake2/debug_kit": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "autoload": {
        "classmap": ["src/"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-paths": {
            "plugins/{$name}/": ["type:cakephp-plugin"]
        }
    }
}

# Environment variables of the tests.
#
# The tests run with APP_ENV=test (tests/bootstrap.php, bin/cake test and
# webroot/test.php set it when it is not set), so config/core.php loads this
# file instead of config/.env. The files are not merged, so this file sets all
# the variables of the tests. See config/.env.example for the details of each
# variable.
#
# This file is committed. Real environment variables (shell, CI) win over it:
# set your own test database as a real DATABASE_URL, or change it here.
#
# Never put real secrets in this file.

# Debug level: 0 (production), 1 or 2 (development). true = 2, false = 0.
DEBUG="2"

# Security.salt, Security.cipherSeed and Cookie.key. The tests do not need
# secret values; unset variables fall back to the defaults in config/core.php.
#SECURITY_SALT=""
#SECURITY_CIPHER_SEED=""
#COOKIE_KEY=""

# The test database. DATABASE_URL sets both the "test" connection (the
# fixtures) and the "default" connection, which the web server of the
# End-to-End tests uses, so the pages read the fixtures.
DATABASE_URL="mysql://user:password@localhost:3306/test_database_name?encoding=utf8mb4"

# Do not send emails in the tests.
MAILER_DSN="null://null"

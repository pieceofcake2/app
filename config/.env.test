# Environment variables of the tests (APP_ENV=test, set by tests/bootstrap.php).
#
# This file is committed. config/core.php loads it instead of config/.env, and
# the files are not merged, so it sets all the variables of the tests; see
# config/.env.example for each variable. Real environment variables (shell, CI)
# win over it. Put per-machine values (your test database) in a copy of this
# file, config/.env.test.local, which is ignored by git and loaded instead, or
# in the environment.
#
# Never put real secrets in this file.

# Debug level: 0 (production), 1 or 2 (development). true = 2, false = 0.
DEBUG="2"

# Security.salt, Security.cipherSeed and Cookie.key. The tests need no secret
# values; unset variables fall back to the defaults in config/core.php.
#SECURITY_SALT=""
#SECURITY_CIPHER_SEED=""
#COOKIE_KEY=""

# The test database. DATABASE_URL sets both the "test" connection (the
# fixtures) and the "default" connection, which the web server of the
# End-to-End tests uses, so the pages read the fixtures.
DATABASE_URL="mysql://user:password@localhost:3306/test_database_name?encoding=utf8mb4"

# Do not send emails in the tests.
MAILER_DSN="null://null"

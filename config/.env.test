# Environment variables of the tests (APP_ENV=test, set by tests/bootstrap.php, bin/cake test and
# webroot/test.php). Committed. config/core.php loads it after config/.env (config/.env.local is not
# loaded in the tests), so it holds only what the tests change. Real environment variables (shell,
# CI) win over it; put the test database of your machine in config/.env.test.local, which is
# ignored by git, or in the environment.

# The test database. DATABASE_URL sets both the "test" connection (the fixtures) and the
# "default" connection, which the web server of the End-to-End tests uses, so the pages read
# the fixtures.
DATABASE_URL="mysql://user:password@localhost:3306/test_database_name?encoding=utf8mb4"

# Do not send emails in the tests.
MAILER_DSN="null://null"

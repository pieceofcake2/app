# Environment variables of the tests (APP_ENV=test, set by tests/bootstrap.php).
#
# This file is committed. config/core.php loads it before config/.env.local and
# config/.env, so its values win over them; real environment variables (shell,
# CI) win over all files. Put per-machine values (your test database) in
# config/.env.test.local, which is ignored by git, or in the environment.
#
# Never put real secrets in this file.

# The test database. With APP_ENV=test, DATABASE_URL sets both the "test"
# connection (the fixtures) and the "default" connection, which the web server
# of the End-to-End tests uses, so the pages read the fixtures.
DATABASE_URL="mysql://user:password@localhost:3306/test_database_name?encoding=utf8mb4"

# Do not send emails in the tests.
MAILER_DSN="null://null"

/**
 * This is email configuration file.
 *
 * Use it to configure email transports of CakePHP.
 *
 * Email configuration class.
 * You can specify multiple configurations for production, development and testing.
 *
 * transport => The name of a supported transport; valid options are as follows:
 *  Mail - Send using PHP mail function
 *  Smtp - Send using SMTP
 *  Debug - Do not send the email, just return the result
 *
 * You can add custom transports (or override existing transports) by adding the
 * appropriate file to src/Lib/Network/Email (or src/Network/Email). Transports should be
 * named 'YourTransport.php', where 'Your' is the name of the transport.
 *
 * from =>
 * The origin email. See CakeEmail::from() about the valid values
 *
 * dsn =>
 * A mailer DSN in the format of Symfony Mailer (needs pieceofcake2/cakephp 2.12.7 or later):
 *  smtp://user:password@smtp.example.com:587 (Smtp; STARTTLS on port 587 or with ?tls=1)
 *  smtps://user:password@smtp.example.com:465 (Smtp over SSL/TLS)
 *  sendmail://default or native://default (Mail, PHP mail())
 *  null://null (Debug, nothing is sent)
 * Query parameters set the other keys (timeout, client, ...). Encode reserved
 * characters of the password (%40 for @). The keys in the DSN replace the same keys
 * of the profile, and the other keys are kept. An empty dsn is ignored.
 *
 * Environment variables:
 * MAILER_DSN sets the transport of the `default` profile. See config/.env.example.
 */
class EmailConfig
{
    /**
     * The default profile. MAILER_DSN replaces the transport keys it sets.
     *
     * @var array
     */
    public $default = [
        'transport' => 'Mail',
        'from' => 'you@localhost',
        //'charset' => 'utf-8',
        //'headerCharset' => 'utf-8',
    ];

    public $smtp = [
        'transport' => 'Smtp',
        'from' => ['site@localhost' => 'My Site'],
        'host' => 'localhost',
        'port' => 25,
        'timeout' => 30,
        'username' => 'user',
        'password' => 'secret',
        'client' => null,
        'log' => false,
        //'charset' => 'utf-8',
        //'headerCharset' => 'utf-8',
    ];

    public $fast = [
        'from' => 'you@localhost',
        'sender' => null,
        'to' => null,
        'cc' => null,
        'bcc' => null,
        'replyTo' => null,
        'readReceipt' => null,
        'returnPath' => null,
        'messageId' => true,
        'subject' => null,
        'message' => null,
        'headers' => null,
        'viewRender' => null,
        'template' => false,
        'layout' => false,
        'viewVars' => null,
        'attachments' => null,
        'emailFormat' => null,
        'transport' => 'Smtp',
        'host' => 'localhost',
        'port' => 25,
        'timeout' => 30,
        'username' => 'user',
        'password' => 'secret',
        'client' => null,
        'log' => true,
        //'charset' => 'utf-8',
        //'headerCharset' => 'utf-8',
    ];

    /**
     * Constructor. Reads the transport of the default profile from MAILER_DSN.
     */
    public function __construct()
    {
        $this->default['dsn'] = env('MAILER_DSN');
    }
}

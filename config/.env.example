# Environment variables for local development.
#
# Copy this file to config/.env (or to .env in the project root) and adjust
# the values. Both files are loaded at the top of config/core.php when they
# exist, and both are ignored by git.
#
# Precedence: real environment variables > config/.env > root .env.
# Variables that are already set in the real environment (web server, shell,
# container, CI) are never overwritten, and config/.env wins over the root
# .env. In production, set real environment variables instead of using a
# .env file.
#
# Unset or empty variables fall back to the defaults in config/core.php,
# config/bootstrap.php, config/database.php and config/email.php.
#
# Always quote values. Unquoted numbers are normalized by the parser
# (e.g. 007 becomes 7, and long digit strings such as a cipher seed overflow).

# Debug level: 0 (production), 1 or 2 (development). true = 2, false = 0.
DEBUG="2"

# Security.salt: a random string used in security hashing methods.
# Generate one with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#SECURITY_SALT=""

# Security.cipherSeed: only for legacy use of CookieComponent's 'cipher' type
# (Security::cipher()). Use a number from 1 to 4294967295, at most 10 digits:
# longer values all end up as the same seed. No value makes 'cipher' secure;
# use the 'aes' type with COOKIE_KEY instead.
# Generate one with: php -r 'echo random_int(1, 4294967295), PHP_EOL;'
#SECURITY_CIPHER_SEED=""

# Cookie.key: the CookieComponent key for the 'aes' type (32 random bytes or
# more). Read by CookieComponent from pieceofcake2/cakephp 2.12.6; with 2.12.5
# and earlier, assign it in AppController (see docs/README.md). When unset,
# Security.salt is used. The 'aes' type needs Security.useOpenSsl = true, which
# config/core.php sets.
# Generate one with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
#COOKIE_KEY=""

# Database connection of config/database.php (copied from
# config/database.php.default), as a DSN. The scheme selects the datasource,
# query parameters set other keys (encoding, schema, prefix, persistent, ...).
# Encode reserved characters of the password (%40 for @, %3F for ?, %23 for #).
# Keys that the DSN does not set keep the values in config/database.php.
# Needs the release of pieceofcake2/cakephp after 2.12.6.
#
# MySQL:      mysql://user:password@localhost:3306/database_name?encoding=utf8mb4
# PostgreSQL: postgres://user:password@localhost:5432/database_name?schema=public
# SQLite:     sqlite:///tmp/database.sqlite (relative to the working directory)
#             sqlite:////var/db/database.sqlite (absolute path)
#             sqlite:///:memory:
# SQL Server: sqlserver://user:password@localhost:1433/database_name?encoding=utf8
#DATABASE_URL="mysql://user:password@localhost:3306/database_name?encoding=utf8mb4"

# Test database (the "test" connection), in the same format.
#DATABASE_TEST_URL="mysql://user:password@localhost:3306/test_database_name?encoding=utf8mb4"

# Email transport of the "default" profile in config/email.php (copied from
# config/email.php.default), as a Symfony Mailer DSN. Needs
# the release of pieceofcake2/cakephp after 2.12.6.
#
# SMTP with STARTTLS: smtp://user:password@smtp.example.com:587
# SMTP over SSL/TLS:  smtps://user:password@smtp.example.com:465
# Local SMTP server:  smtp://localhost:1025 (e.g. Mailpit)
# PHP mail():         sendmail://default or native://default
# Do not send:        null://null
#MAILER_DSN="smtp://localhost:1025"

# Cache and log configurations as DSNs, with the names of the CakePHP 5 app
# skeleton. The keys in the DSN replace the same keys of the configuration in
# config/core.php (_cake_core_, _cake_model_) and config/bootstrap.php
# (default, debug, error). Needs the release of pieceofcake2/cakephp after 2.12.6.
#
# Cache: file:///path/to/cache/, apcu://, memcached://localhost:11211,
#        redis://:password@localhost:6379/0
# Log:   file:///path/to/logs, console://?stream=php://stderr, syslog://
#CACHE_DEFAULT_URL="redis://localhost:6379/0?prefix=myapp_"
#CACHE_CAKECORE_URL="redis://localhost:6379/0"
#CACHE_CAKEMODEL_URL="redis://localhost:6379/0"
#LOG_DEBUG_URL="console://?stream=php://stdout"
#LOG_ERROR_URL="console://?stream=php://stderr"
